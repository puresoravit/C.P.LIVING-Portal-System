// ==========================================================
// BILL SYSTEM — Database Schema
// อ้างอิงจาก Requirement ข้อ 1-80 (ดู /docs/REQUIREMENTS.md)
// Phase 1 (Foundation) จะ implement เต็มเฉพาะ:
//   User, Role, Customer, Branch, ProductType, Product
// ตารางอื่น (Price/Discount/Order/Invoice/...) สร้างโครงไว้ก่อน
// เพื่อไม่ให้ต้อง migrate ทับใหญ่ตอน Phase 2-4 (ตามข้อ 73 Future Expansion)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Phase 1: AUTH / USER / ROLE ----------

enum Role {
  OWNER_ADMIN // ข้อ 3.1 — ทำได้ทุกอย่าง
  BILLING_STAFF // ข้อ 3.2 — สร้าง/แก้ Order, Print, ค้นหา — แก้ Price/Discount Master ไม่ได้
  VIEWER // ข้อ 3.3 — ดู Dashboard/Report/Export เท่านั้น
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  passwordHash  String // bcrypt — ห้ามเก็บ plain text (ข้อ 51)
  displayName   String
  role          Role
  active        Boolean  @default(true)
  // R6 Phase F — Owner ตัวจริงของธุรกิจ (คนละแนวคิดกับ Role OWNER_ADMIN ซึ่งเป็นชุด
  // Permission ภายในแอพ Billing): เฉพาะ isOwner=true เท่านั้นที่เห็น/ใช้ Access
  // Management บน Application Portal ได้ — ตาม Requirement ตรงๆ ว่า "Admin/User Manager
  // ห้ามได้สิทธิ์นี้อัตโนมัติ" จึงต้องเป็น Flag ชัดเจนที่ DB ไม่ผูกกับ Role/Permission เดิม
  // — Owner มีสิทธิ์เข้าทุก Application โดยปริยาย (ไม่ต้องมีแถว UserAppAccess)
  isOwner       Boolean  @default(false)
  // R6 Phase F — Owner UAT: My Profile — คำนำหน้าชื่อ (ค่า "MR"/"MS" ตรวจฝั่ง Server ผ่าน
  // TITLE_PREFIX_OPTIONS ใน user-profile.ts, ไม่ผูก DB Enum เพื่อขยายตัวเลือกในอนาคตได้
  // โดยไม่ต้อง Migrate ซ้ำ) — null = ไม่ระบุ (พฤติกรรมเดิมทุกประการ แสดงชื่อเปล่าๆ)
  titlePrefix   String?
  // Base64 Data URI ของรูป Profile — Pattern เดียวกับ template.logo ทุกประการ (เก็บตรงๆ
  // ใน DB ไม่เขียนไฟล์ลง /public, Validate ชนิด/ขนาดฝั่ง Server เสมอ — ดู
  // AVATAR_MAX_BYTES/validateAvatarDataUri ใน user-profile.ts) — null = ยังไม่มีรูป
  // แสดง Fallback เป็นตัวอักษรแรกของชื่อ (พฤติกรรมเดิมของ Portal Header)
  avatarDataUri String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs AuditLog[]
  appAccess UserAppAccess[]
  passkeys  WebAuthnCredential[]

  @@map("users")
}

// Phase G — Passkey/WebAuthn: Public Credential ของ Authenticator (Face ID/Touch ID/
// Fingerprint/Passkey Provider) — เก็บ "เฉพาะ" สิ่งที่ WebAuthn Spec ต้องใช้ตอน Verify:
// credentialId + publicKey (COSE, ฝั่ง Public เท่านั้น) + signCount + transports/flags —
// Private Key อยู่กับ Authenticator/Device เสมอ ไม่เคยออกจากเครื่อง, ข้อมูล Biometric
// (ลายนิ้วมือ/ใบหน้า) ไม่เคยถูกส่งมาที่ Server ตาม Spec จึงไม่มีคอลัมน์ให้เก็บได้เลย —
// User หนึ่งคนมีได้หลาย Credential (iPhone/Samsung/Mac แยกแถวกัน Revoke ทีละตัวได้)
model WebAuthnCredential {
  id         String    @id // credentialID (base64url) — Authenticator กำหนด, Unique ระดับโลก
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  publicKey  Bytes // COSE Public Key (ฝั่ง Public เท่านั้น)
  counter    BigInt    @default(0) // signCount กัน Cloned Authenticator (Passkey แบบ Sync มักเป็น 0 เสมอ)
  transports String[]  @default([]) // ["internal","hybrid",...] ช่วย Browser เลือก Authenticator ให้ถูก
  deviceType String // "singleDevice" | "multiDevice" (Synced Passkey)
  backedUp   Boolean   @default(false)
  label      String // ชื่อที่ User ตั้ง เช่น "iPhone ของฉัน"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

// Phase G — Challenge ชั่วคราวสำหรับ Registration/Authentication — เก็บใน DB (ไม่ใช่
// In-memory) ให้รอดข้าม Process Restart/หลาย Instance และลบทิ้งเมื่อใช้แล้ว (Single-use)
// — userId มีเฉพาะ Registration (ผูกกับ Session ที่ขอ) ส่วน Authentication เป็น null
// เพราะยังไม่รู้ว่าใคร (Discoverable Credential/Usernameless) แต่ตรวจผูกกับ Credential
// ที่ตอบกลับมาอีกชั้นตอน Verify — แถวหมดอายุถูกกวาดทิ้งทุกครั้งที่ออก Challenge ใหม่
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String // base64url random 32 bytes (จาก Library)
  type      String // "registration" | "authentication"
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// R6 Phase F — App Access ชั้นที่ 1 (เข้า Application ไหนได้บ้าง) — แยกชัดจาก Permission
// Matrix เดิม (ชั้นที่ 2: เข้าแอพแล้วทำอะไรได้ ยังใช้ Role/can() เดิมทุกประการ ไม่แตะเลย)
// มีแถว = ได้สิทธิ์เข้าแอพนั้น (appId อ้างอิง Central App Registry ในโค้ด —
// src/lib/app-registry.ts — ไม่มี Table Application แยกเพราะรายชื่อแอพเป็นเรื่องของ
// Codebase/Route ที่มีจริง ไม่ใช่ข้อมูลที่ผู้ใช้สร้างเองได้)
model UserAppAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  appId       String
  grantedById String? // User id ของ Owner ที่กดให้สิทธิ์ (Audit ฉบับเต็มอยู่ใน AuditLog)
  createdAt   DateTime @default(now())

  @@unique([userId, appId])
  @@map("user_app_access")
}

// ---------- Phase 1: CUSTOMER / BRANCH ----------

enum CreditTerm {
  CASH // เงินสด (ปัจจุบันลูกค้าทุกรายใช้แบบนี้ — ตาม clarification ข้อ 8)
  NET30
  NET60
  NET90
}

model Customer {
  id          String     @id @default(cuid())
  code        String     @unique // Customer Code เช่น PN02 (ข้อ 4)
  companyName String
  taxId       String?
  phone       String?
  email       String?
  creditTerm  CreditTerm @default(CASH)
  // Owner UAT (2026-08-23) — สถานที่ส่งสินค้า/ที่อยู่ของลูกค้าเอง: ลูกค้าบางรายไม่มีสาขา
  // (Branch) เลย การดึงที่อยู่ได้จากสาขาอย่างเดียวจึงไม่พอ — ใช้เป็น Fallback ทุกจุดที่เคย
  // อ่าน branch.address (Auto-fill ตอนสร้างเอกสาร + addressSnapshot ตอน Confirm):
  // เลือกสาขา → ใช้ที่อยู่สาขา, ไม่เลือกสาขา → ใช้ที่อยู่นี้
  address     String?
  note        String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  branches          Branch[]
  priceRules        PriceRule[]
  discountRules     DiscountRule[]
  orders            Order[]
  invoices          Invoice[]
  taxInvoices       TaxInvoice[]
  billingNotes      BillingNote[]
  repairReturnNotes RepairReturnNote[]
  quotations        Quotation[]
  productAccess     ProductCompanyAccess[]
  catalogMembership ProductCatalogCompany?
  privateProducts   Product[]              @relation("CustomerPrivateProducts")
  privateModels     ProductModel[]         @relation("CustomerPrivateModels")
  linkedProspects   QuotationProspect[]
  // Production Module (P1)
  customerPos       CustomerPO[]
  productAliases    ProductAlias[]

  @@map("customers")
}

model Branch {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  code          String // Branch Code
  name          String // Branch Name
  taxBranchCode String? // เช่น 00000 / 00001 (ข้อ 5)
  address       String?
  province      String?
  postalCode    String?
  phone         String?
  contactPerson String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  priceRules        PriceRule[]
  discountRules     DiscountRule[]
  orders            Order[]
  invoices          Invoice[]
  taxInvoices       TaxInvoice[]
  repairReturnNotes RepairReturnNote[]
  quotations        Quotation[]
  // Production Module (P1)
  customerPos       CustomerPO[]
  productAliases    ProductAlias[]
  orderSequence     BranchOrderSequence?

  @@unique([customerId, code]) // ข้อ 61: Branch Code ซ้ำภายใต้ Customer เดียวกันห้าม
  @@map("branches")
}

// ---------- Phase 1: PRODUCT TYPE / PRODUCT ----------

model ProductType {
  id                 String   @id @default(cuid())
  code               String   @unique // ข้อ 6: TYPE A / TYPE B / TYPE C ... (ขยายได้ไม่ hardcode)
  name               String
  description        String?
  // Production Smoke Test (2026-08-25) — Owner: กำหนด % ส่วนลดตรงที่กลุ่มได้เลย ไม่ต้อง
  // สร้าง DiscountRule รายลูกค้าทีละใบ — เป็น Fallback Tier ใหม่ใน getEffectiveDiscountPct
  // (Branch Rule → Customer Rule → "ค่านี้" → 0%) — null = กลุ่มนี้ไม่มีส่วนลดตั้งต้น
  // (พฤติกรรมเดิมทุกประการ) — DiscountRule เดิมยังทำงานเหมือนเดิมและ Override ค่านี้เสมอ
  defaultDiscountPct Decimal? @db.Decimal(5, 2)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products      Product[]
  productModels ProductModel[]
  discountRules DiscountRule[]

  @@map("product_types")
}

// R6 — Product Architecture Correction: "ประเภทสินค้า" เชิงคุณลักษณะจริง (ฟูกที่นอน/
// หมอน/อื่นๆ) แยกคนละ Concept จาก ProductType เดิม (ซึ่งใช้จริงเป็น "กลุ่มส่วนลด" ผูกกับ
// DiscountRule/Auto-Split Invoice — เปลี่ยนแค่ Label ผู้ใช้ ไม่แตะ Schema/Relation เดิม)
// usesSize ใช้ตัดสินที่ Document Entry (Phase B) ว่า Category นี้ต้องเลือก Size ไหม โดย
// ไม่ต้อง Hardcode รายชื่อ Category ในโค้ด — เพิ่ม Category ใหม่ได้จากหน้า Management ตรงๆ
model ProductCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  usesSize  Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  models   ProductModel[]

  @@map("product_categories")
}

// Phase B — Master สำหรับ "รุ่นสินค้า" (เช่น GT-David) ที่ครอบคลุมหลาย SKU/Size
// ของ Product เดียวกัน ใช้สำหรับ Group ยอดขายใน Dashboard/Report ระดับ Model แทนการ
// แยกราย SKU — ตั้งใจแยกเป็นตารางจริง (ไม่ใช่ free-text field บน Product) เพื่อกัน
// พิมพ์ชื่อ Model ไม่ตรงกันระหว่าง SKU ที่ควรเป็นรุ่นเดียวกัน (เช่น "GT-David" vs
// "gt david") ตามที่ตัดสินใจไว้ (ทางเลือก B)
model ProductModel {
  id            String           @id @default(cuid())
  productTypeId String
  productType   ProductType      @relation(fields: [productTypeId], references: [id])
  // R6 — nullable: จัดหมวดได้ทีหลัง ไม่บังคับตอน Migrate (ข้อมูลเดิมทั้งหมด categoryId = null)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  name          String // เช่น "GT-David"
  // R6 Phase B — ราคาต่อฟุต สำหรับ Category ที่ usesSize=true (เช่นฟูกที่นอน) ใช้คำนวณ
  // Standard Price ของ Standard Variant (3/3.5/4/5/6 ฟุต) อัตโนมัติ = pricePerFoot × size
  // ค่าตัวเลข Size มาจากตารางค่าคงที่ในโค้ด (product-variant-size.ts) เท่านั้น ไม่เคย
  // Parse จาก String — nullable เพราะ Category ที่ไม่ใช้ Size ไม่ต้องมีค่านี้เลย
  pricePerFoot  Decimal?         @db.Decimal(12, 2)
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // R9 — Company Catalog (เหมือน Product.catalogId ทุกประการ)
  catalogId       String?
  catalog         ProductCatalog? @relation(fields: [catalogId], references: [id])
  // R10 — Private (เหมือน Product.ownerCustomerId ทุกประการ)
  ownerCustomerId String?
  ownerCustomer   Customer?       @relation("CustomerPrivateModels", fields: [ownerCustomerId], references: [id])

  products      Product[]
  companyAccess ProductCompanyAccess[]
  // Production Module (P1) — ProductModel เป็น "ตระกูลสินค้า" ให้ Production reuse ตรงๆ
  aliases       ProductAlias[]

  @@unique([productTypeId, name]) // กัน Model ชื่อซ้ำเป๊ะภายใน Type เดียวกัน
  @@map("product_models")
}

// R8 (2026-08-26) — Product Assignment ตามบริษัทลูกค้า: จำกัดว่าสินค้า Family ไหนเปิดให้
// บริษัท (Customer) ไหนเลือกใช้ในเอกสารได้บ้าง — ออกแบบเป็น "Allowlist ระดับ Family Head"
// ไม่ใช่รายแถว Product:
//   - ไม่มีแถวเลยสำหรับ Family นั้น = สินค้าส่วนกลาง เปิดให้ทุกบริษัท (Default — ข้อมูล
//     Production เดิมทั้งหมดเข้าเคสนี้ทันทีโดยไม่ต้อง Backfill = Zero-behavior-change ตอน Migrate)
//   - มีแถว = เปิดเฉพาะบริษัทที่มีแถวเท่านั้น
// Family Head คือจุดเดียวที่ผูกแถว (กัน Variant แต่ละ Size ต้องตั้งซ้ำและ Drift กันเอง):
//   - productModelId → ProductModel Family (Variant ทุกตัวของ Model ตามหัวเสมอ)
//   - productId → Standalone Product หรือ Product Anchor (pricePerFoot) — Variant ที่มี
//     parentProductId ตามหัว (Anchor) เสมอ ไม่มีแถวของตัวเอง
// productId/productModelId เป็น XOR (แถวหนึ่งผูกอย่างใดอย่างหนึ่ง) — บังคับที่ Application
// Layer (Server Action เป็นผู้สร้างเสมอ) ตาม Pattern เดียวกับ PriceRule scope เดิม
// การลบ/เปลี่ยนแถว = เปลี่ยนแค่ "ตัวเลือกตอนสร้างเอกสารใหม่" — ไม่แตะ Product จริง ไม่แตะ
// เอกสารเก่า/Snapshot ใดๆ ทั้งสิ้น (เอกสารอ้าง productId + Snapshot ของตัวเองเสมอ)
model ProductCompanyAccess {
  id             String        @id @default(cuid())
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  productModelId String?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  grantedById    String? // User id ผู้กำหนดสิทธิ์ (Audit ฉบับเต็มอยู่ใน AuditLog)
  createdAt      DateTime      @default(now())

  @@unique([productId, customerId])
  @@unique([productModelId, customerId])
  @@index([customerId])
  @@map("product_company_access")
}

// R9 (2026-08-26) — Company-first Catalog: "กลุ่มบริษัทที่ใช้รายการสินค้าร่วมกัน" เป็นวิธี
// หลักของการกำหนดว่าใครเห็นสินค้าไหน (ตาม UX ใหม่ของ Owner: รายการสินค้า → เลือกบริษัท →
// เห็น/เพิ่ม/แก้สินค้าของบริษัทนั้น — หลายบริษัทแชร์ Catalog เดียวกันได้ เช่น A+B+C โดย
// เพิ่ม/ถอดบริษัทจากหน้าเดียว ไม่ต้อง Assign ทีละสินค้า):
//   - 1 บริษัท อยู่ได้สูงสุด 1 Catalog (customerId unique) — โมเดลใจของ Owner คือ "หน้า
//     บริษัท = รายการสินค้าของบริษัทนั้น" การแชร์คือดึงบริษัทอื่นเข้ามาใช้รายการเดียวกัน
//   - Product/ProductModel (Family Head) ผูก catalogId — สินค้าที่สร้างจากหน้า Catalog ผูก
//     กลุ่มนั้นอัตโนมัติ / catalogId = null คือ "สินค้าส่วนกลาง" ตามกฎเดิม (ทุกบริษัทเห็น
//     เว้นแต่มีแถว ProductCompanyAccess จำกัดไว้ — กลไกเก่ายังทำงานเพื่อ Compatibility แต่
//     UX หลักคือ Catalog)
// การลบบริษัทออกจาก Catalog เปลี่ยนแค่การมองเห็นตอนสร้างเอกสารใหม่ — ไม่แตะ Product จริง
// ไม่แตะเอกสารเก่า/Snapshot ใดๆ (หลักการเดียวกับ ProductCompanyAccess เดิมทุกประการ)
model ProductCatalog {
  id                 String   @id @default(cuid())
  name               String
  // R10 — "สินค้าเสนอราคา": Catalog พิเศษหนึ่งเดียวสำหรับใบเสนอราคาแบบกรอกข้อมูลเอง
  // (Guest QT) — ไม่มีบริษัทสมาชิกเลยโดยเจตนา จึงไม่มีทางโผล่ให้ Customer Master เห็น
  // ผ่านกฎสมาชิกกลุ่มปกติ (Default ตาม Requirement) — เห็นได้เฉพาะ Scope "guest" ของ
  // Product Search (ดู quotationGuestWhere ใน product-company-access.ts) — สร้าง/ค้นหา
  // ผ่าน ensureQuotationCatalog() เท่านั้น (Singleton โดยการใช้งาน ไม่ใช่ Constraint)
  isQuotationCatalog Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companies     ProductCatalogCompany[]
  products      Product[]
  productModels ProductModel[]

  @@map("product_catalogs")
}

model ProductCatalogCompany {
  id         String         @id @default(cuid())
  catalogId  String
  catalog    ProductCatalog @relation(fields: [catalogId], references: [id])
  // unique = 1 บริษัทอยู่ได้ Catalog เดียว (ดูเหตุผลใน Comment ของ ProductCatalog)
  customerId String         @unique
  customer   Customer       @relation(fields: [customerId], references: [id])
  addedById  String? // User id ผู้เพิ่มบริษัทเข้ากลุ่ม (Audit ฉบับเต็มอยู่ใน AuditLog)
  createdAt  DateTime       @default(now())

  @@map("product_catalog_companies")
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique // ข้อ 7
  name            String
  // R4 — nullable: สินค้าที่ไม่มีประเภทจริงๆ (เช่นอุปกรณ์เบ็ดเตล็ด) ขายได้ปกติ ใช้
  // Standard/Customer-specific Price ตามเดิม แต่ไม่มี Type-specific Discount (0% เสมอ
  // เพราะ DiscountRule.productTypeId ยัง required) — จัดกลุ่มเป็น "GEN" (Internal Code)
  // / "ไม่ระบุประเภท" (User-facing) ตอน Auto-Split Invoice — ไม่แตะ ProductModel/
  // DiscountRule.productTypeId เพราะทั้งคู่ยังต้องผูก Type เสมอตาม Design เดิม
  productTypeId   String?
  productType     ProductType?     @relation(fields: [productTypeId], references: [id])
  // R6 — Product Category เชิงคุณลักษณะ (ฟูกที่นอน/หมอน/อื่นๆ) แยกจาก productTypeId
  // (กลุ่มส่วนลด) โดยสิ้นเชิง — nullable เพราะสินค้าเดิมทั้งหมดยังไม่ได้จัดหมวด
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  modelId         String? // Phase B — nullable ถาวร: Product ที่ยังไม่ได้ assign
  // Model (หรือไม่มี Model ที่มีความหมาย เช่นสินค้าตัวเดียว
  // ไม่มี Size variant) ยังใช้งาน/ขายได้ปกติทุกอย่าง — ห้าม
  // auto-derive จากชื่อ ต้องให้คนกำหนดเอง (Human-reviewed)
  model           ProductModel?    @relation(fields: [modelId], references: [id])
  size            String?
  unit            String // เช่น หลัง, ใบ
  standardPrice   Decimal          @db.Decimal(12, 2) // ราคารวม VAT แล้ว (VAT-inclusive) — ยืนยันแล้ว
  description     String?
  active          Boolean          @default(true)
  // Owner UAT — ข้อ 1: Product เป็น "Family Anchor" ของ Size/Pricing ได้เอง โดยไม่ต้องพึ่ง
  // ProductModel แยกต่างหาก — ตั้ง pricePerFoot ที่ Product ตรงๆ (เมื่อ category.usesSize
  // =true) แล้ว Product แถวนี้จะกลายเป็น "Anchor" ของ Size Family ตัวเอง — parentProductId
  // ชี้กลับไปหา Anchor นั้นสำหรับ Product แถวอื่นที่เป็น Size Variant ของมัน (Auto-sync จาก
  // syncStandardVariants เดิม แค่ขยายให้ทำงานกับ Product Parent ได้ ไม่ใช่แค่ ProductModel
  // Parent) — Additive ล้วนๆ ไม่แตะ modelId/ProductModel เดิมแม้แต่นิดเดียว (Backward
  // Compatible เต็มรูปแบบ — Product ที่ผูก modelId เดิมยังทำงานเหมือนเดิมทุกประการ)
  pricePerFoot    Decimal?         @db.Decimal(12, 2)
  parentProductId String?
  parentProduct   Product?         @relation("ProductSizeFamily", fields: [parentProductId], references: [id])
  sizeVariants    Product[]        @relation("ProductSizeFamily")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // R9 — Company Catalog ของ Family Head (null = สินค้าส่วนกลาง) — Variant ตามหัวเสมอ
  // ไม่มีค่าของตัวเอง (Resolution ผ่าน resolveAccessHead ใน product-company-access.ts)
  catalogId       String?
  catalog         ProductCatalog? @relation(fields: [catalogId], references: [id])
  // R10 — Private Product: สินค้าเฉพาะบริษัทเดียว (สมาชิกอื่นในกลุ่มไม่เห็น) — ตั้งได้
  // เฉพาะ Family Head และ Mutually Exclusive กับ catalogId (Application Layer บังคับ:
  // Private → catalogId null เสมอ) — ลำดับตัดสินการมองเห็น: Private → Shared (Catalog)
  // → ส่วนกลาง/Allowlist เดิม (ดู companyAccessWhere)
  ownerCustomerId String?
  ownerCustomer   Customer?       @relation("CustomerPrivateProducts", fields: [ownerCustomerId], references: [id])

  priceRules     PriceRule[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]
  quotationItems QuotationItem[]
  companyAccess  ProductCompanyAccess[]

  // ---------- Production Module (P1) — เพิ่มแบบ Additive, nullable ทั้งหมด ----------
  // ห้ามทำสำเนา Product Master — เพิ่มแค่ field ที่ Production ต้องใช้ ไม่แตะของเดิมเลย
  // "ตระกูลสินค้า" ของ Production reuse modelId/parentProductId เดิม ไม่มี familyId ใหม่
  // (ดู docs/production-module/02-P1-schema-decisions.md)
  form             String? // "นอน" | "Box" | ... (ค่าตั้งค่าใน AppSetting ไม่ hardcode)
  material         String?
  color            String?
  thickness        String?
  productionStatus ProductionStatus? // แยกจาก `active` (Billing) โดยเจตนา — คนละความหมาย
  // ชื่อที่แสดงบนใบสั่งผลิต/ใบขึ้นของ อาจต่างจาก `name` ที่ใช้ในเอกสารบิล — null = ใช้ name เดิม
  productionLabel  String?
  aliases          ProductAlias[]
  customerPoLines  CustomerPOLine[]
  productionItems  ProductionItem[]

  @@map("products")
}

enum ProductionStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

// ---------- Phase 2 (โครงไว้ก่อน): PRICE / DISCOUNT / VAT ----------

// ราคาตั้งต้นก่อนหักส่วนลด (ข้อ 8-13) — ผูกได้ทั้งระดับ Product / Customer / Branch
// scope: ถ้า customerId=null,branchId=null = fallback มาจาก Product.standardPrice แทน (ไม่ต้องมี record)
// ถ้า customerId!=null,branchId=null = Customer Special Price (ข้อ 10)
// ถ้า customerId!=null,branchId!=null = Branch Special Price (ข้อ 11, priority สูงสุด — ข้อ 12)
model PriceRule {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  price         Decimal   @db.Decimal(12, 2) // ราคาตั้งต้นก่อนหักส่วนลด, รวม VAT แล้ว
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = ไม่มีวันหมดอายุ
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId, customerId, branchId])
  @@map("price_rules")
}

// ส่วนลด % ตาม Customer/Branch × Product Type (ข้อ 14-15)
model DiscountRule {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  branchId      String? // null = apply ทุกสาขาของ Customer นี้ (ข้อ 14)
  branch        Branch?     @relation(fields: [branchId], references: [id])
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  discountPct   Decimal     @db.Decimal(5, 2) // เช่น 10.00 = 10%
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId, branchId, productTypeId])
  @@map("discount_rules")
}

model VatRate {
  id            String    @id @default(cuid())
  ratePct       Decimal   @default(7.00) @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@map("vat_rates")
}

// ---------- Phase 3-4 (โครงไว้ก่อน): ORDER / INVOICE ----------

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // ORDER-YYYYMM-##### (ข้อ 22, 30)
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  // Owner UAT Fix Batch 1 — ข้อ 3: บริษัทที่ไม่มีสาขาต้องสร้างเอกสารได้ด้วย Customer
  // อย่างเดียว — Branch เป็น Optional (Additive, ไม่ลบ Architecture) แถวเดิมที่มี
  // branchId อยู่แล้วไม่กระทบ
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  orderDate       DateTime
  reference       String?
  note            String?
  placeToDelivery String? // สถานที่ส่งสินค้า — แยกจาก Branch Address ได้ (ตามฟอร์มจริง, แก้ไขได้อิสระ)
  status          OrderStatus @default(DRAFT)
  // R3 — Calculation Toggle จริง (ไม่ใช่ Presentation): false = ข้าม DiscountRule
  // lookup ไปเลย บังคับ discountPct/discountAmount = 0 ที่ต้นทางใน computeOrderPreview()
  // default true = พฤติกรรมเดิมของระบบทุกประการ (Backward Compatible กับเอกสารเก่า)
  applyDiscount   Boolean     @default(true)
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  invoices Invoice[]

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  quantity            Decimal  @db.Decimal(12, 2)
  // รายละเอียดที่แสดงบนเอกสาร: default ดึงจาก Product.name แต่ override ได้ (ข้อ "หมายเหตุก่อนข้อ11" — ไซส์พิเศษ)
  descriptionOverride String?
  // R6 Phase B — "ขนาดพิเศษ/ระบุเอง": User พิมพ์ Size/ราคาเองตอนคีย์เอกสาร ไม่ผ่าน
  // pricePerFoot/getEffectivePrice เลย — nullable เพราะ Standard Size ไม่ใช้ 2 ฟิลด์นี้
  // (ยังคงต้องมี productId จริงเป็น Anchor ของ Model เดิมเสมอ ตาม FK required ด้านบน)
  sizeOverride        String?
  unitPriceOverride   Decimal? @db.Decimal(12, 2)

  @@map("order_items")
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PRINTED
  CANCELLED
  // PAID — จะเพิ่มใน Phase Payment ในอนาคต (ข้อ 28, 74)
}

// Invoice ที่แตกจาก Order ตาม Product Type (ข้อ 19, 22-27)
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // INV-{Type}-YYYYMM-#### (ข้อ 22, 30)
  parentOrderId   String // ข้อ 23: Parent Order Relation
  order           Order    @relation(fields: [parentOrderId], references: [id])
  invoiceDate     DateTime
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  // Owner UAT Fix Batch 1 — ข้อ 3: เหมือน Order.branchId ทุกประการ (สร้างมาจาก
  // Order.branchId ตอน Confirm — ถ้า Order ไม่มีสาขา Invoice ก็ไม่มีสาขาเช่นกัน)
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  productTypeCode String // snapshot ชื่อ Type ตอนแตกบิล (ไม่ join ทีหลัง)

  // --- Snapshot fields (ข้อ 27) — ห้ามอ้างอิง Master Data สด ---
  customerNameSnapshot String
  taxIdSnapshot        String?
  // Owner UAT Fix Batch 1 — ข้อ 3: null ได้เมื่อไม่มีสาขา (Additive)
  branchNameSnapshot   String?
  addressSnapshot      String?
  placeToDelivery      String? // จุดสีเหลือง #4 — เพิ่มตาม form จริง

  grossAmount    Decimal @db.Decimal(14, 2)
  discountPct    Decimal @db.Decimal(5, 2)
  discountAmount Decimal @db.Decimal(14, 2)
  // R3 — Snapshot ของ Order.applyDiscount ณ ตอน Confirm/E3-Reissue เพื่อแยกความหมาย
  // "ไม่มี Discount Rule จริง (discountPct=0 ตามกฎ)" ออกจาก "มี Rule แต่ผู้ใช้ตั้งใจ
  // เลือกไม่ใช้ส่วนลด (applyDiscount=false)" ให้ตรวจสอบย้อนหลังได้ชัดเจน
  applyDiscount  Boolean @default(true)
  netBeforeVat   Decimal @db.Decimal(14, 2)
  vatPct         Decimal @db.Decimal(5, 2)
  vatAmount      Decimal @db.Decimal(14, 2)
  grandTotal     Decimal @db.Decimal(14, 2)

  status      InvoiceStatus @default(DRAFT)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // R6 Phase D — Sales SOT: PRINTED ต้องแปลว่า "ยืนยันพิมพ์กระดาษต่อเนื่อง 9×11 จริงแล้ว"
  // เท่านั้น (ไม่ใช่แค่เคยกด window.print()) — printedAt เป็น First-Printed Timestamp
  // เขียนครั้งเดียวตอน CONFIRMED→PRINTED เท่านั้น (Reprint ไม่ overwrite เพราะ Action
  // เช็ค status ก่อนเขียนเสมอ) printedById ไม่ผูก Relation ตาม Convention เดียวกับ
  // createdById ด้านบน (Plain String)
  printedAt   DateTime?
  printedById String?

  items         InvoiceItem[]
  taxInvoices   TaxInvoice[]
  billingNoteId String? // ข้อ 19: ใบวางบิลรวมหลาย Invoice — null = ยังไม่เคยถูกวางบิล
  billingNote   BillingNote?  @relation(fields: [billingNoteId], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id                  String  @id @default(cuid())
  invoiceId           String
  invoice             Invoice @relation(fields: [invoiceId], references: [id])
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  skuSnapshot         String
  productNameSnapshot String // override ได้ตอนคีย์ (ไซส์พิเศษ)
  productTypeSnapshot String
  sizeSnapshot        String? // Phase C — nullable ถาวร: รายการเก่าก่อน migration นี้
  // ไม่มีค่า ห้ามเอา Product.size ปัจจุบันย้อนไปเติมให้
  // (ผิดหลัก Document Snapshot) ตอน Print ให้แสดงว่างถ้า null
  quantity            Decimal @db.Decimal(12, 2)
  unitSnapshot        String
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  grossAmount         Decimal @db.Decimal(14, 2)
  discountAmount      Decimal @db.Decimal(14, 2)
  netAmount           Decimal @db.Decimal(14, 2)
  vatAmount           Decimal @db.Decimal(14, 2)
  totalAmount         Decimal @db.Decimal(14, 2)
  // Smoke Test R12 (2026-08-25) — Owner: "ยอดสุทธิ (Net)" ของ Dashboard/รายงานยอดขาย ต้องหัก
  // ส่วนลดกลุ่มเสมอตามกลุ่มของสินค้า ไม่ขึ้นกับว่าใบส่งของใบนี้เลือกใช้/แสดงส่วนลดหรือไม่
  // (การแสดงบนกระดาษเป็นการตัดสินใจของ Owner แยกจากตัวเลขวิเคราะห์โดยสิ้นเชิง) — Snapshot
  // ณ ตอน Confirm ด้วย Resolver เดียวกับส่วนลดจริง (Branch Rule → Customer Rule → % กลุ่ม
  // → 0) จัดสรรต่อบรรทัดแบบเดียวกับ discountAmount ทุกประการ — ถ้าใบนี้ใช้ส่วนลดจริงอยู่แล้ว
  // ค่านี้ = discountAmount เป๊ะ / รายงานคำนวณ Net = grossAmount − statDiscountAmount
  statDiscountAmount  Decimal @default(0) @db.Decimal(14, 2)

  @@map("invoice_items")
}

// ---------- Phase 5: TAX INVOICE (แยกจาก Invoice — ไม่ผูก 1:1 เสมอไป) ----------
// ตามที่ยืนยันในการหารือ: ลูกค้าส่วนใหญ่แจ้งรายการ/ยอดเองว่าต้องการใบกำกับ
// ภาษีเท่าไร (พนักงานเลือกรายการ/ยอดเอง = Manual) ส่วนลูกค้าที่ขอ VAT 100%
// เต็มยอด generate จาก Invoice ได้เลย (Auto) — referenceInvoiceId เป็น
// null ได้ถ้าเป็น Manual mode ล้วนๆ ไม่ได้อิง Invoice ใบไหนโดยตรง

enum TaxVatCalcMode {
  EXTRACT
  ADD_ON
}

enum TaxInvoiceStatus {
  CONFIRMED
  // Smoke Test R13 (2026-08-25) — Owner: ลูกค้า VAT เต็มบางรายออกใบกำกับภาษีตรงโดยไม่ผ่าน
  // ใบส่งของชั่วคราว → ยอดขายหาย — เพิ่ม PRINTED Checkpoint แบบเดียวกับ Invoice (พิมพ์ 9×11
  // + ยืนยันด้วยมือ) พร้อมคำถามเพิ่ม "นับเป็นยอดขายไหม" (countAsSales) เพราะใบกำกับบางใบ
  // ซ้ำยอดกับ Invoice ที่นับไปแล้ว — นับซ้ำไม่ได้เด็ดขาด Owner เป็นคนตัดสินใจต่อใบ
  PRINTED
  CANCELLED
}

model TaxInvoice {
  id                 String   @id @default(cuid())
  taxInvoiceNumber   String   @unique // TX-YYYYMM-### (ข้อ 22 pattern เดียวกัน)
  taxInvoiceDate     DateTime
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  // Owner UAT Fix Batch 1 — ข้อ 3: เหมือน Order.branchId ทุกประการ
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id])
  referenceInvoiceId String? // ถ้าสร้างแบบ Auto จาก Invoice ใบเดียว — Manual mode ปล่อยว่างได้
  referenceInvoice   Invoice? @relation(fields: [referenceInvoiceId], references: [id])

  customerNameSnapshot String
  taxIdSnapshot        String?
  // Owner UAT Fix Batch 1 — ข้อ 3: null ได้เมื่อไม่มีสาขา (Additive)
  branchNameSnapshot   String?
  addressSnapshot      String?
  placeToDelivery      String?

  // Phase H — Discount บนใบกำกับภาษี (Additive): grossAmount = ยอดรวมรายการก่อนหัก
  // ส่วนลด (VAT-inclusive — ตรงกับผลรวมคอลัมน์จำนวนเงินของ Item), discountAmount =
  // ส่วนลดรวมทั้งเอกสาร (VAT-inclusive, Default 0) — ใบเก่าก่อน Phase นี้ grossAmount
  // เป็น null: ตอนแสดงผลให้ Fallback = netAmount (ใบเก่าไม่มีส่วนลดจริงๆ ห้าม Backfill
  // ข้อมูลย้อนหลังตามหลัก Document Snapshot)
  grossAmount    Decimal? @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @db.Decimal(14, 2)
  valueAmount    Decimal  @db.Decimal(14, 2) // มูลค่าสินค้าก่อน VAT (ฐานภาษีหลังหักส่วนลด)
  vatPct         Decimal  @db.Decimal(5, 2)
  vatAmount      Decimal  @db.Decimal(14, 2)
  netAmount      Decimal  @db.Decimal(14, 2) // สุทธิ = valueAmount + vatAmount (ยอดรวม VAT-inclusive หลังหักส่วนลด)

  // R11 (2026-08-27) — วิธีคิด VAT ของใบนี้ (Snapshot ตรวจย้อนหลังได้):
  //   EXTRACT (Default — พฤติกรรมเดิมทุกใบ) = ราคาที่กรอกรวม VAT แล้ว ถอดออกมาแสดง
  //   ADD_ON = ราคาที่กรอกยังไม่รวม VAT บวกเพิ่มตามอัตรา (ฐาน = ยอดหลังหักส่วนลด)
  // โหมด AUTO (ดึงจากใบส่งของ) เป็น EXTRACT เสมอ — ส่วนลดหักก่อน VAT เสมอทั้งสองโหมด
  vatCalcMode  TaxVatCalcMode   @default(EXTRACT)
  status       TaxInvoiceStatus @default(CONFIRMED)
  // R13 — PRINTED Checkpoint (Pattern เดียวกับ Invoice.printedAt/printedById ทุกประการ)
  printedAt    DateTime?
  printedById  String?
  // R13 — true = Owner ยืนยันตอนพิมพ์ว่าให้นับใบนี้เข้ายอดขาย/ยอดสุทธิ (Dashboard/รายงาน)
  // — ใช้กับเคสออกใบกำกับตรงแทนใบส่งของ ใบที่ซ้ำยอดกับ Invoice ให้ตอบไม่นับ กันนับซ้ำ
  countAsSales Boolean          @default(false)
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items TaxInvoiceItem[]

  @@map("tax_invoices")
}

model TaxInvoiceItem {
  id             String     @id @default(cuid())
  taxInvoiceId   String
  taxInvoice     TaxInvoice @relation(fields: [taxInvoiceId], references: [id])
  description    String // ข้อความอิสระ — ไม่ผูกกับ Product Master เสมอไป (Manual mode พิมพ์เองได้)
  size           String? // Phase C — ช่องกรอกเองแยกจาก description เพราะ TaxInvoiceItem
  // ไม่ผูก Product Master เลย จึง derive จาก Master ไม่ได้
  quantity       Decimal    @db.Decimal(12, 2)
  unit           String
  unitPrice      Decimal    @db.Decimal(12, 2) // ราคารวม VAT ต่อหน่วย
  amount         Decimal    @db.Decimal(14, 2) // quantity × unitPrice (ก่อนหักส่วนลดบรรทัด)
  // Phase H — ส่วนลดต่อบรรทัด (Additive, Default 0): ใช้ทั้งโหมด AUTO (สืบทอดจาก
  // InvoiceItem.discountAmount) และ MANUAL (กรอกเอง/ตาม Discount Group) — ผลรวมทุก
  // บรรทัดต้องเท่ากับ TaxInvoice.discountAmount เสมอ
  discountAmount Decimal    @default(0) @db.Decimal(14, 2)

  @@map("tax_invoice_items")
}

// ---------- Phase 5: BILLING NOTE (ใบวางบิล — สรุปหลาย Invoice ที่ครบกำหนด) ----------
// ตามตัวอย่างเอกสารจริง: รวม Invoice หลายใบของลูกค้า 1 ราย ที่ยังไม่เคย
// ถูกวางบิลมาก่อน (Invoice.billingNoteId = null) เป็นเอกสารเดียว
enum BillingNoteStatus {
  CONFIRMED
  // Smoke Test R5 (2026-08-25) — Owner: ใบวางบิลต้องมี Checkpoint "พิมพ์แล้ว" แบบเดียวกับ
  // Invoice (เดิมสร้างปุ๊บขึ้น "ยืนยันแล้ว" ทันที ทำให้เข้าใจผิดว่าพิมพ์ไปแล้วทั้งที่ยังไม่ได้กด
  // พิมพ์เลย) — CONFIRMED = สร้างแล้วยังไม่พิมพ์, PRINTED = ยืนยันพิมพ์กระดาษจริงแล้ว
  // (ผ่าน Confirmation Modal เดิมของ PrintButton — เฉพาะโปรไฟล์ 9×11 เหมือน Invoice)
  PRINTED
  CANCELLED
}

model BillingNote {
  id                   String            @id @default(cuid())
  billingNoteNumber    String            @unique // BI-YYYYMM-### (ข้อ 22 pattern เดียวกัน)
  billingNoteDate      DateTime
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id])
  customerNameSnapshot String
  taxIdSnapshot        String?
  addressSnapshot      String?
  creditTermSnapshot   String            @default("CASH") // ข้อ 6 Document Snapshot — กันวันครบกำหนดขยับย้อนหลังถ้าลูกค้าเปลี่ยน credit term ทีหลัง
  // Smoke Test (2026-08-25) — Owner: ใบส่งของส่วนใหญ่ออกราคาเต็ม (กันลูกน้องฝั่งลูกค้าเห็น
  // ส่วนลด) แต่ใบวางบิลคือเงินเก็บจริงกับเจ้าของ จึงเลือกได้ตอนสร้างว่าจะหักส่วนลดกลุ่มไหม
  // — discountDetail เป็น Snapshot [{invoiceId, pct, amount, alreadyDiscounted}] ณ วันวางบิล
  // (ใบพิมพ์ต้องนิ่งตลอดไปแม้ % กลุ่มเปลี่ยนทีหลัง — Snapshot Principle ข้อ 27 เดิม) —
  // Invoice ที่หักส่วนลดไปแล้วตอนออกใบ (discountAmount > 0) ห้ามหักซ้ำ (Owner ยืนยันชัดเจน)
  // — totalAmount ยังคงเป็น "ยอดที่เรียกเก็บจริง" (หลังหักส่วนลดใบวางบิล ถ้ามี)
  applyDiscount        Boolean           @default(false)
  discountDetail       Json?
  totalAmount          Decimal           @db.Decimal(14, 2)
  // R5 — PRINTED Checkpoint (Pattern เดียวกับ Invoice.printedAt/printedById ทุกประการ):
  // เขียนครั้งเดียวตอน CONFIRMED→PRINTED, Reprint ไม่ Overwrite
  printedAt            DateTime?
  printedById          String?
  status               BillingNoteStatus @default(CONFIRMED)
  createdById          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  invoices Invoice[]

  @@map("billing_notes")
}

// ---------- Phase 5: REPAIR RETURN NOTE (ใบส่งคืนสินค้าฝากซ่อม) ----------
// เอกสารอิสระ ไม่ผูกกับ Order/Invoice/ราคา (ไม่ใช่การขาย) — แค่บันทึกว่า
// ส่งของที่ซ่อมเสร็จแล้วคืนลูกค้า อาจอ้างอิงถึงเอกสารอื่นได้ในหมายเหตุ
enum RepairReturnStatus {
  CONFIRMED
  CANCELLED
}

model RepairReturnNote {
  id                   String             @id @default(cuid())
  noteNumber           String             @unique // DEP-YYYYMM-### (ข้อ 22 pattern เดียวกัน)
  noteDate             DateTime
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id])
  // Owner UAT Fix Batch 1 — ข้อ 3: เหมือน Order.branchId ทุกประการ
  branchId             String?
  branch               Branch?            @relation(fields: [branchId], references: [id])
  customerNameSnapshot String
  addressSnapshot      String?
  placeToDelivery      String?
  reference            String?
  remark               String?
  status               RepairReturnStatus @default(CONFIRMED)
  createdById          String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items RepairReturnNoteItem[]

  @@map("repair_return_notes")
}

model RepairReturnNoteItem {
  id                 String           @id @default(cuid())
  repairReturnNoteId String
  repairReturnNote   RepairReturnNote @relation(fields: [repairReturnNoteId], references: [id])
  description        String // ข้อความอิสระ ไม่ผูก Product Master
  // Owner UAT Fix Batch 1 — ข้อ 5: เชื่อม Product Search Picker เป็น Autofill Helper
  // (Client-side ล้วนๆ) — ยังไม่ผูก FK กับ Product Master ตามเจตนาเดิมของเอกสารนี้
  // ทุกประการ (mirror TaxInvoiceItem.size เป๊ะ)
  size               String?
  quantity           Decimal          @db.Decimal(12, 2)
  unit               String

  @@map("repair_return_note_items")
}

// ---------- Quotation — ใบเสนอราคา ----------
// เอกสารแยกเด็ดขาดจาก Order/Invoice (ไม่ผูก Relation ใดๆ กับกัน ไม่นับใน Dashboard/
// Report/Sales SOT/Billing Note/Tax Invoice) ใช้สำหรับเสนอราคาลูกค้าเท่านั้น ยังไม่มี
// Convert-to-Order ในรอบนี้ — Snapshot ทุกฟิลด์ที่จำเป็นตอน Confirm/Revision เพื่อให้
// เปิดย้อนหลังเห็นราคา/ส่วนลด/VAT ณ วันที่ Confirm เสมอ แม้ Master Data จะถูกแก้ทีหลัง
enum QuotationStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// STANDARD ไม่ Hardcode อัตราไว้ในชื่อ Enum เพราะอัตราจริงต้องอ้างอิง Effective VAT
// Rate ตามวันที่เอกสารเสมอ (เก็บอัตราจริงที่ใช้แยกไว้ที่ vatRateSnapshot)
enum QuotationVatMode {
  NONE
  STANDARD
  // R11 (2026-08-27) — Owner: "เพิ่ม VAT จากราคาขาย" — ฐาน VAT = ยอดขายหลังหักส่วนลด
  // แล้วบวก VAT เพิ่มตามอัตรา (ยอดรวมเพิ่มขึ้น) — ต่างจาก STANDARD ที่ "ถอด" VAT ออกจาก
  // ราคาขายที่รวม VAT อยู่แล้ว (ยอดรวมไม่เปลี่ยน) — ส่วนลดหักก่อน VAT เสมอทั้งสองโหมด
  ADD_ON
}

// R10 — "ใบเสนอราคาลูกค้าที่ไม่มีในระบบ": ราย (Prospect) ของลูกค้าที่กรอกข้อมูลเองตอน
// สร้าง Guest QT — 1 Guest QT ใหม่ = 1 Prospect ใหม่เสมอ (ห้าม Auto-merge จากชื่อโดยไม่
// ให้ User ยืนยัน — การรวมรายทำผ่าน mergeProspects ที่ User กดยืนยันเองเท่านั้น) —
// linkedCustomerId = เชื่อมกับ Customer Master แล้ว (สร้างใหม่จากข้อมูลราย หรือเลือกของ
// เดิม) — QT เก่าไม่ถูกแตะเลย (customerId ของ QT ยังเป็น null + Snapshot เดิมทุกประการ
// ตาม Document Snapshot Principle — Prospect เป็นแค่สมุดรวมประวัติ/จุดเชื่อม)
model QuotationProspect {
  id               String    @id @default(cuid())
  name             String
  taxId            String?
  address          String?
  contactPerson    String?
  phone            String?
  linkedCustomerId String?
  linkedCustomer   Customer? @relation(fields: [linkedCustomerId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  quotations Quotation[]

  @@map("quotation_prospects")
}

model Quotation {
  id              String             @id @default(cuid())
  // R10 — ราย (Prospect) ของ Guest QT — ตั้งเฉพาะใบที่กรอกข้อมูลเอง (customerId null)
  prospectId      String?
  prospect        QuotationProspect? @relation(fields: [prospectId], references: [id])
  quotationNumber String             @unique // QT-YYYYMM-##### (5 หลัก, Sequence แยกจาก Order/Invoice)
  quotationDate   DateTime
  // Fresh UAT Phase H — Guest/Manual Customer เฉพาะใบเสนอราคา: customerId เป็น null ได้
  // (ลูกค้าที่กรอกเองโดยไม่สร้าง Customer Master) — ข้อมูลลูกค้าทั้งหมดของ Guest อยู่ใน
  // Snapshot fields ด้านล่างตั้งแต่ตอนสร้าง Draft เลย (ไม่ใช่รอตอน Confirm แบบลูกค้า
  // Master) เพื่อเปิด/พิมพ์ย้อนหลังได้เสมอ — เอกสารอื่นทุกประเภท (Order/Invoice/Tax
  // Invoice/Billing Note) ยังบังคับ Customer Master เหมือนเดิมทุกประการ
  customerId      String?
  // onDelete: Restrict ระบุชัด — Optional Relation ใน Prisma จะ Default เป็น SET NULL
  // ซึ่งเปลี่ยนพฤติกรรมเดิม (เดิม Required = RESTRICT ลบลูกค้าที่มีใบเสนอราคาไม่ได้)
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Owner UAT Fix Batch 1 — ข้อ 3: เหมือน Order.branchId ทุกประการ
  branchId        String?
  branch          Branch?            @relation(fields: [branchId], references: [id])
  reference       String?
  note            String?
  placeToDelivery String?
  vatMode         QuotationVatMode   @default(NONE)
  // R3 — Calculation Toggle จริง (เหมือน Order.applyDiscount ทุกประการ) — เปลี่ยนได้ทั้ง
  // ตอน DRAFT และตอน Revision (mirror ของ vatMode ที่เปลี่ยนได้ตอน Revision อยู่แล้ว)
  applyDiscount   Boolean            @default(true)

  // --- Snapshot fields — null ตอน DRAFT, เติมค่าตอน Confirm/Revision เท่านั้น
  // ห้าม Print อ่าน Master สดหลัง Confirm แล้วเด็ดขาด ---
  customerNameSnapshot  String?
  customerTaxIdSnapshot String?
  branchNameSnapshot    String?
  addressSnapshot       String?
  // Phase H — Guest Customer เท่านั้นที่ใช้ 2 Field นี้ (ผู้ติดต่อ/โทรศัพท์ที่กรอกเอง)
  // ลูกค้า Master เป็น null เสมอ (ข้อมูลติดต่ออยู่ที่ Customer Master ตามเดิม)
  contactSnapshot       String?
  phoneSnapshot         String?
  grossAmount           Decimal? @db.Decimal(14, 2)
  discountAmount        Decimal? @db.Decimal(14, 2)
  vatRateSnapshot       Decimal? @db.Decimal(5, 2) // อัตรา VAT จริงที่ใช้ ณ ตอน Confirm/Revision
  netBeforeVat          Decimal? @db.Decimal(14, 2)
  vatAmount             Decimal? @db.Decimal(14, 2)
  grandTotal            Decimal? @db.Decimal(14, 2)

  // Revision — Confirm แรก = 0, แก้ตอน CONFIRMED แต่ละครั้ง +1 (แก้ตอน DRAFT ไม่นับ)
  // ป้องกันลูกค้า/บริษัทถือ Quotation เลขเดียวกันแต่คนละเวอร์ชันโดยไม่รู้ตัว
  revisionNo Int             @default(0)
  status     QuotationStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id                  String    @id @default(cuid())
  quotationId         String
  quotation           Quotation @relation(fields: [quotationId], references: [id])
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  quantity            Decimal   @db.Decimal(12, 2)
  descriptionOverride String?
  // R6 Phase B — "ขนาดพิเศษ/ระบุเอง" เหมือน OrderItem ทุกประการ
  sizeOverride        String?
  unitPriceOverride   Decimal?  @db.Decimal(12, 2)

  // --- Snapshot fields — null ตอน DRAFT, เติมค่าตอน Confirm/Revision เท่านั้น ---
  skuSnapshot         String?
  productNameSnapshot String?
  productTypeSnapshot String?
  sizeSnapshot        String?
  unitSnapshot        String?
  unitPriceSnapshot   Decimal? @db.Decimal(12, 2)
  grossAmount         Decimal? @db.Decimal(14, 2)
  discountAmount      Decimal? @db.Decimal(14, 2)
  netAmount           Decimal? @db.Decimal(14, 2) // VAT-inclusive ต่อบรรทัด — VAT แยกคิดที่ Header เท่านั้น

  @@map("quotation_items")
}

// ---------- Phase infra: RUNNING NUMBER / AUDIT / SETTINGS ----------

// Running Number แบบ concurrency-safe (ข้อ 30, 52) — ใช้ atomic increment ผ่าน DB transaction
model DocumentSequence {
  id      String @id @default(cuid())
  docType String // เช่น "ORDER", "INV-A", "INV-B", "INV-C", "DEP", "TX", "BI"
  period  String // เช่น "202608" — รีเซ็ตทุกเดือน (ยืนยันแล้ว)
  lastSeq Int    @default(0)

  @@unique([docType, period])
  @@map("document_sequences")
}

// R4 — SKU Auto-generate: แยกจาก DocumentSequence เด็ดขาด เพราะ SKU เป็น Product
// Identity ถาวร ห้าม Reset ตามเดือนเหมือนเลขเอกสาร (DocumentSequence ผูก period ที่
// รีเซ็ตทุกเดือนโดยตั้งใจ ใช้ผิด concept กันไม่ได้) — Atomic Increment แบบเดียวกับ
// getNextSeq ทุกประการ (upsert กัน Race Condition) แถวเดียวคงที่ (id=1) นับต่อเนื่องไม่รีเซ็ต
model ProductSkuSequence {
  id      Int @id @default(1)
  lastSeq Int @default(0)

  @@map("product_sku_sequence")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / DELETE / CANCEL / LOGIN ...
  module    String // Price / Discount / Product / Customer / Order / Invoice / Permission
  recordId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  // ---------- Production Module (P1) — เพิ่มแบบ Additive, nullable ทั้งหมด ----------
  // Reuse AuditLog เป็น Timeline กลางของ Production แทนการสร้างตาราง event ใหม่คู่ขนาน
  // (ดู docs/production-module/02-P1-schema-decisions.md) — แถวของ Billing เดิมทุกแถว
  // ปล่อยเป็น null หมด ไม่กระทบพฤติกรรมเดิม
  customerId    String? // เก็บซ้ำเพื่อความเร็วของหน้าประวัติบริษัท (เปิดบ่อยที่สุด)
  branchId      String?
  customerPoId  String? // ชี้ไปยัง CustomerPO (โมดูล Production เท่านั้น ไม่ใช่ FK บังคับ)
  correlationId String? // กลุ่ม AuditLog ที่เกิดจาก action เดียวกัน (เช่น กระทบยอดครั้งเดียวกระทบหลาย entity)
  reason        String?

  @@index([module, recordId])
  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
  @@index([customerPoId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

// ==========================================================================
// ---------- Production & Delivery Module (P1) ----------
// business logic แยกจาก Billing โดยสิ้นเชิง — Product Master ใช้ร่วมกัน (เพิ่ม field
// บน Product/ProductModel เท่านั้น ไม่ทำสำเนา) ดู docs/production-module/ สำหรับสเปกเต็ม
// และ docs/production-module/02-P1-schema-decisions.md สำหรับเหตุผลการตัดสินใจ schema นี้
//
// ชื่อโมเดลใช้ prefix "CustomerPO"/"Production" ตั้งใจไม่ใช้ "Order" เฉยๆ เพราะ Order/
// OrderItem มีอยู่แล้วสำหรับ Billing (คนละความหมาย — ใบสั่งขายก่อนออกใบแจ้งหนี้)
// และไม่ใช้ "PurchaseOrder" เฉยๆ ด้วย เพราะคำนี้ในความหมายมาตรฐาน ERP/บัญชีคือฝั่งที่
// "เราสั่งซื้อจาก Supplier" (Procurement ขาออก) ตรงข้ามกับที่นี่ซึ่งคือ "รับ P.O. จากลูกค้า"
// เข้ามา — ถ้าวันหน้าทำระบบจัดซื้อจริงจะชนความหมายทันที จึงใช้ "CustomerPO" ให้ชัดว่าเป็น
// P.O. ฝั่งลูกค้าโดยเฉพาะ
// ==========================================================================

enum AliasScope {
  GLOBAL
  CUSTOMER
  BRANCH
}

// ชื่อเรียกอื่นๆ ของตระกูลสินค้า — ตระกูลสินค้า reuse ProductModel เดิม (หรือ Product เดี่ยว
// สำหรับสินค้าที่เป็น Anchor ของตัวเองแบบไม่มี ProductModel แยก — Family Head Pattern
// เดียวกับ ProductCompanyAccess.productId/productModelId) productModelId/productId เป็น
// XOR บังคับที่ Application Layer เหมือน resolveAccessHead() ใน product-company-access.ts
// (ทั้งระบบไม่มี DB CHECK constraint เลยสักที่ — ยึด convention เดิม)
model ProductAlias {
  id              String        @id @default(cuid())
  productModelId  String?
  productModel    ProductModel? @relation(fields: [productModelId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  aliasText       String // ตามที่มีคนพิมพ์/เขียนจริง เช่น "เดวิท"
  aliasNormalized String // lowercase + ตัด whitespace ซ้ำ — ใช้ค้นหา/กันซ้ำในแต่ละ scope
  lang            String?
  scope           AliasScope    @default(GLOBAL)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  source          String        @default("manual")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([aliasNormalized])
  @@map("product_aliases")
}

// Lifetime counter ต่อสาขา ("สั่งครั้งที่ N") ไม่รีเซ็ต — เลียนแบบ ProductSkuSequence/
// getNextSkuSeq เป๊ะ (atomic upsert กัน race condition จริง ไม่ query MAX+1)
model BranchOrderSequence {
  branchId String @id
  branch   Branch @relation(fields: [branchId], references: [id])
  lastSeq  Int    @default(0)

  @@map("branch_order_sequences")
}

enum DateMode {
  UNSET
  ESTIMATE
  EXACT
}

model CustomerPO {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  dateMode      DateMode  @default(UNSET)
  requestedDate DateTime?
  orderSeqNo    Int? // จาก BranchOrderSequence ตอนสร้าง (นับ per branch — ยืนยันแล้ว)
  urgency       Boolean   @default(false)
  status        String // ค่าตั้งค่าใน AppSetting ไม่ hardcode
  poImagePaths  String[] // P1 shortcut — เตรียม migrate เป็น Attachment model ภายหลัง
  version       Int       @default(0) // optimistic lock กัน lost update (reject + reload, ไม่ auto-merge)
  revCounter    Int       @default(0) // ที่มาของ revNo แบบ atomic ให้ CustomerPORevision
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines            CustomerPOLine[]
  revisions        CustomerPORevision[]
  productionOrders ProductionOrder[]

  @@map("customer_pos")
}

enum OrderLineKind {
  CATALOG
  UNRESOLVED
}

model CustomerPOLine {
  id              String        @id @default(cuid())
  customerPoId    String
  customerPo      CustomerPO    @relation(fields: [customerPoId], references: [id])
  lineKind        OrderLineKind @default(CATALOG)
  productId       String? // null เมื่อ lineKind = UNRESOLVED (สินค้ายังไม่มีใน Product Master)
  product         Product?      @relation(fields: [productId], references: [id])
  rawProductText  String? // ชื่อที่พนักงานคีย์ตรงๆ เมื่อ productId เป็น null
  size            String?
  qtyCurrent      Int
  urgency         Boolean       @default(false)
  requiredDate    DateTime?
  isCustomSize    Boolean       @default(false)
  customW         Decimal?      @db.Decimal(8, 2)
  customL         Decimal?      @db.Decimal(8, 2)
  customThickness String?
  note            String?

  revisionChanges CustomerPORevisionChange[]
  productionItems ProductionItem[]

  @@map("customer_po_lines")
}

// Revision = header + รายการ changes ภายใน (1 การบันทึก อาจแก้ได้หลายบรรทัดพร้อมกัน)
model CustomerPORevision {
  id           String     @id @default(cuid())
  customerPoId String
  customerPo   CustomerPO @relation(fields: [customerPoId], references: [id])
  revNo        Int // จาก CustomerPO.revCounter แบบ atomic (compare-and-swap)
  reason       String?
  actorId      String
  createdAt    DateTime   @default(now())

  changes CustomerPORevisionChange[]

  @@unique([customerPoId, revNo])
  @@map("customer_po_revisions")
}

enum RevisionChangeType {
  ADD_LINE
  QTY_CHANGE
  CANCEL_LINE
  RESOLVE_PRODUCT // ผูก UNRESOLVED line เข้ากับ SKU จริงทีหลัง
  ORDER_LEVEL // เปลี่ยนแปลงระดับทั้งออเดอร์ ไม่ผูกกับบรรทัดเดียว (ยกเลิกทั้งใบ/เปลี่ยนวันที่)
}

model CustomerPORevisionChange {
  id          String             @id @default(cuid())
  revisionId  String
  revision    CustomerPORevision @relation(fields: [revisionId], references: [id])
  orderLineId String? // null = ORDER_LEVEL change
  orderLine   CustomerPOLine?    @relation(fields: [orderLineId], references: [id])
  changeType  RevisionChangeType
  qtyDelta    Int?
  before      Json
  after       Json

  @@map("customer_po_revision_changes")
}

// ใบสั่งผลิต — เลขที่เอกสารใช้ DocumentSequence/getNextSeq/formatDocNumber เดิม
// (docType="PROD", period=YYYYMM) → PROD-202608-00012 ไม่ต้องมี sequence แยก
//
// แก้ไขหลัง Verify จริง (ดู docs/production-module/02-P1-schema-decisions.md ส่วน "ถอน
// ข้อสรุป Quotation pattern"): ProductionOrder เป็น "identity" คงที่ (เลขที่เอกสาร +
// สถานะปัจจุบัน) — เนื้อหาจริงแต่ละ Rev (รายการ/ผ้า/ชั้นโครงสร้าง) อยู่ใน
// ProductionOrderRevision + ProductionItem + ProductionItemLayer เป็น "แถวใหม่ทุก Rev
// ไม่เคย UPDATE/DELETE ของเดิม" — เพราะ Quotation pattern เดิม (deleteMany + createMany
// items, เก็บแค่สรุปย่อใน AuditLog) ไม่พอให้ reconstruct/reprint ใบเก่าแบบเป๊ะๆ ได้จริง
// ซึ่งจำเป็นสำหรับใบสั่งผลิต (ตรวจสอบย้อนตอนผลิตผิดต้องเห็นสเปกผ้า/ชั้นเป๊ะตามวันที่ออกจริง)
model ProductionOrder {
  id           String     @id @default(cuid())
  prodNo       String     @unique
  customerPoId String
  customerPo   CustomerPO @relation(fields: [customerPoId], references: [id])
  currentRevNo Int        @default(0) // ชี้ revision ล่าสุด (ใช้แสดงผล/พิมพ์เป็นค่าเริ่มต้น)
  revCounter   Int        @default(0) // ที่มาของ revNo แบบ atomic (เหมือน CustomerPO.revCounter)
  status       String // ค่าตั้งค่าใน AppSetting
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  revisions ProductionOrderRevision[]

  @@map("production_orders")
}

// 1 แถว = 1 Rev ที่เคยออก/พิมพ์จริง — Immutable ทันทีที่สร้าง (ห้าม update เนื้อหาแถวเดิม)
//
// P1 decision: แถวนี้ (รวม revNo=0 ฉบับแรก) ถูกสร้างเฉพาะตอนกด Confirm/Issue เท่านั้น —
// ไม่มี "draft" ที่ persist ลง DB มาก่อนเลย ProductionOrder + ProductionOrderRevision
// (revNo=0) แรกสุดถูกสร้างพร้อมกันในทรานแซกชันเดียวตอนนั้น การร่าง/แก้ก่อนกดยืนยันเป็น
// client-side form state ล้วนๆ (ตรงกับ P1 ที่คีย์ครั้งเดียวจบ ไม่มี save-draft-กลับมาแก้
// ทีหลัง) — ด้วยเหตุนี้ confirmedAt จึงตั้งค่าเสมอ (ไม่ nullable) ต่างจาก printedAt ที่เป็น
// action แยกทีหลัง (พิมพ์ซ้ำได้หลายครั้งหลัง confirm)
//
// revNo=0 คือฉบับแรก, revNo>0 แสดงผล/พิมพ์เป็น "-N" ต่อท้าย prodNo (เหมือน
// Quotation.revisionNo/displayQuotationNumber — ส่วนนี้ยัง reuse pattern เดิมได้ เพราะเป็น
// แค่การคำนวณ suffix ตอนแสดงผล ไม่เกี่ยวกับการเก็บเนื้อหา)
model ProductionOrderRevision {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  revNo             Int
  confirmedAt       DateTime        @default(now()) // เสมอ — แถวนี้เกิดขึ้นตอน Confirm/Issue เท่านั้น ไม่มี draft state
  printedAt         DateTime?
  reason            String? // เหตุผลที่ออก Rev ใหม่ (ว่างได้เฉพาะ revNo=0)
  actorId           String
  snapshotJson      Json? // snapshot ระดับหัวเอกสาร ณ เวลาที่ล็อก
  createdAt         DateTime        @default(now())

  items ProductionItem[]

  @@unique([productionOrderId, revNo])
  @@map("production_order_revisions")
}

// ผูกกับ Revision โดยตรง (ไม่ใช่ ProductionOrder header) — Rev ใหม่ = สร้างแถวใหม่ทั้งชุด
// เสมอ ไม่แตะแถวของ Rev เก่าเลย ทำให้เปิดพิมพ์ Rev ไหนก็ได้ครบทุกช่องเป๊ะตามวันที่ออกจริง
model ProductionItem {
  id                String                  @id @default(cuid())
  revisionId        String
  revision          ProductionOrderRevision @relation(fields: [revisionId], references: [id])
  customerPoLineId  String?
  customerPoLine    CustomerPOLine?         @relation(fields: [customerPoLineId], references: [id])
  productId         String?
  product           Product?                @relation(fields: [productId], references: [id])
  size              String?
  isCustomSize      Boolean                 @default(false)
  customW           Decimal?                @db.Decimal(8, 2)
  customL           Decimal?                @db.Decimal(8, 2)
  customThickness   String?
  qty               Int
  gussetCount       Int? // กุ๊น
  thickness         String?
  fabricTop         Json // ข้อมูลจริง ใช้คำนวณ spec_hash เท่านั้น
  fabricSide        Json
  fabricBottom      Json
  fabricTopLabel    String? // override การแสดงผล/พิมพ์ — ไม่กระทบ spec_hash
  fabricSideLabel   String?
  fabricBottomLabel String?
  specHash          String
  note              String?

  // Snapshot ล็อกตอน Confirm/Issue ของ Revision แม่ — Product Master เปลี่ยนชื่อทีหลัง
  // ไม่กระทบใบที่ออกไปแล้ว (แถวนี้เองก็ immutable อยู่แล้วตาม Revision ที่มันสังกัด)
  skuSnapshot             String?
  nameSnapshot            String?
  productionLabelSnapshot String?

  layers ProductionItemLayer[]

  @@index([specHash])
  @@map("production_items")
}

model ProductionItemLayer {
  id              String         @id @default(cuid())
  itemId          String
  item            ProductionItem @relation(fields: [itemId], references: [id])
  seq             Int
  material        String
  spec            String
  displayOverride String? // override การแสดงผล/พิมพ์ — ไม่กระทบ spec_hash

  @@map("production_item_layers")
}
