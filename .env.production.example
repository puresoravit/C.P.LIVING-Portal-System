# ตัวอย่าง environment variables สำหรับ PRODUCTION โดยเฉพาะ (ต่างจาก .env.example
# ที่เป็นค่า default สำหรับ local development) — ไฟล์นี้ไม่มี secret จริง
# ปลอดภัยที่จะ commit ได้ ใช้เป็นเอกสารอ้างอิงตอน deploy จริง

# Database — ต้องเป็น connection string ของ Managed PostgreSQL (เช่น จาก
# Railway/Render/Supabase/Neon/RDS) ไม่ใช่ localhost แบบตอน dev
# แต่ละ provider จะให้ connection string มาให้ตรงๆ ตอนสร้าง database แล้ว
# แค่เอามาวางตรงนี้ (provider ส่วนใหญ่ไม่มี query param `schema=` ใน URL
# ให้ต่อท้ายเองถ้า Prisma ต้องการ ตรวจสอบ schema.prisma ก่อน)
DATABASE_URL="postgresql://user:password@your-managed-db-host:5432/bill_system?sslmode=require"

# NextAuth — ต้องเป็น URL จริงของ domain production (ไม่ใช่ localhost)
# NEXTAUTH_URL ต้องขึ้นต้นด้วย https:// เสมอ ไม่งั้น secure cookie จะไม่เปิดใช้
# (ดู useSecureCookies ใน src/lib/auth.ts)
NEXTAUTH_URL="https://your-domain.example.com"

# ⚠️ ห้ามใช้ค่าเดียวกับที่ใช้ตอน dev/local เด็ดขาด — สร้างค่าสุ่มใหม่แยกต่างหาก
# สำหรับ production โดยเฉพาะทุกครั้ง (openssl rand -base64 32)
NEXTAUTH_SECRET="สร้างค่าสุ่มใหม่เฉพาะ production — อย่าใช้ค่าเดียวกับ dev"

# Backup (ข้อ 49) — เช่นเดียวกัน ต้องสร้างค่าสุ่มใหม่แยกจาก dev
# ใช้ป้องกัน endpoint /api/backup/auto (ส่งผ่าน Authorization header เท่านั้น
# ไม่ใช่ query string — ดู README หัวข้อ Backup Strategy)
BACKUP_SECRET="สร้างค่าสุ่มใหม่เฉพาะ production — อย่าใช้ค่าเดียวกับ dev"

# NODE_ENV — ปกติ hosting platform ตั้งให้อัตโนมัติเป็น "production" อยู่แล้ว
# เมื่อรันผ่าน `next start` (ไม่ต้องตั้งเองปกติ แต่ระบุไว้ให้เห็นชัดว่ามีผล
# ต่อ useSecureCookies ในโค้ดจริง)
NODE_ENV=production
