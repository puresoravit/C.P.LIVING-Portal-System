# ==========================================================================
# Template ไฟล์ .env สำหรับ Production — คัดลอกไปเป็น /opt/bill-system/.env
# แล้วเติมค่าจริงทุกช่อง — ห้ามใช้ค่าชุด Development ซ้ำเด็ดขาด
#
# สร้าง Secret ใหม่แต่ละตัวด้วย:  openssl rand -base64 48
# ตั้ง Permission:                chmod 640 .env && chown root:billing .env
# ==========================================================================

# PostgreSQL บนเครื่องเดียวกัน (127.0.0.1 — ไม่เปิดพอร์ตสู่ภายนอก)
# แทน STRONG_DB_PASSWORD ด้วยรหัสที่สร้างใหม่ (openssl rand -base64 24)
DATABASE_URL="postgresql://billing:STRONG_DB_PASSWORD@127.0.0.1:5432/bill_system?schema=public"

# Secret ของ NextAuth — สร้างใหม่ ห้ามใช้ตัว Dev (Session เก่าทั้งหมดจะใช้ไม่ได้ = ถูกต้องแล้ว)
NEXTAUTH_SECRET="REPLACE_WITH_openssl_rand_base64_48"

# URL สาธารณะจริงของระบบ (Subdomain ที่ตั้ง DNS แล้ว) — ต้องเป็น https เสมอ
# ค่านี้ขับทั้ง Auth Callback และ WebAuthn RP ID/Origin อัตโนมัติ (Passkey ผูกกับโดเมนนี้)
NEXTAUTH_URL="https://portal.cplivingmattress.com"

# Secret สำหรับ Endpoint สำรองข้อมูลอัตโนมัติ (/api/backup/auto — เรียกจาก cron)
BACKUP_SECRET="REPLACE_WITH_openssl_rand_base64_48"
