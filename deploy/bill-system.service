# ==========================================================================
# systemd Unit — C.P. LIVING Billing (Next.js Production Server)
#
# ติดตั้ง:
#   sudo cp deploy/bill-system.service /etc/systemd/system/bill-system.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bill-system
# ดูสถานะ/Log:
#   systemctl status bill-system
#   journalctl -u bill-system -f
# ==========================================================================

[Unit]
Description=C.P. LIVING Billing (Next.js)
# ต้องรอ Network และ PostgreSQL พร้อมก่อน
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# ผู้ใช้เฉพาะกิจไม่มีสิทธิ์ root (สร้างตามคู่มือใน README ขั้นตอนที่ 3)
User=billing
Group=billing
WorkingDirectory=/opt/bill-system
# Secrets ทั้งหมดอยู่ในไฟล์ .env ที่ root:billing อ่านได้เท่านั้น (chmod 640)
EnvironmentFile=/opt/bill-system/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Bind เฉพาะ localhost — ประตูสาธารณะทางเดียวคือ Caddy (443) เท่านั้น (Defense-in-depth
# ซ้อนกับ ufw ที่ปิดพอร์ต 3000 อยู่แล้ว) — next start ต้องใช้ Flag -H (HOSTNAME env ไม่มีผล)
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1
Restart=always
RestartSec=5

# Hardening พื้นฐานของ systemd — จำกัดสิ่งที่ Process ทำได้แม้ถูกยึด
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# แอปต้องเขียนได้แค่ logs/ กับ backups/ ใต้ WorkingDirectory เท่านั้น
ReadWritePaths=/opt/bill-system/logs /opt/bill-system/backups

[Install]
WantedBy=multi-user.target
