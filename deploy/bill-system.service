# ==========================================================================
# systemd Unit — C.P. LIVING Billing (Next.js Production Server)
#
# ติดตั้ง:
#   sudo cp deploy/bill-system.service /etc/systemd/system/bill-system.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bill-system
# ดูสถานะ/Log:
#   systemctl status bill-system
#   journalctl -u bill-system -f
# ==========================================================================

[Unit]
Description=C.P. LIVING Billing (Next.js)
# ต้องรอ Network และ PostgreSQL พร้อมก่อน
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# ผู้ใช้เฉพาะกิจไม่มีสิทธิ์ root (สร้างตามคู่มือใน README ขั้นตอนที่ 3)
User=billing
Group=billing
WorkingDirectory=/opt/bill-system
# Secrets ทั้งหมดอยู่ในไฟล์ .env ที่ root:billing อ่านได้เท่านั้น (chmod 640)
EnvironmentFile=/opt/bill-system/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Production Cutover (2026-08-25) — เดิมใส่ -H 127.0.0.1 เพื่อ Bind เฉพาะ Localhost
# แต่พบระหว่าง Smoke Test จริงว่า Flag นี้ทำให้ next-auth Middleware สร้าง Absolute
# Redirect URL ผิดเป็น "http://localhost:3000/login" เสมอ (ไม่ว่า Host Header ที่ส่ง
# มาจริงจะเป็นอะไร — ยืนยันด้วยการรัน 2 แบบเทียบกัน: มี -H ได้ URL Hostname ผิด, ไม่มี
# -H ได้ Redirect แบบ Relative Path ที่ถูกต้อง 100% เพราะ Browser Resolve เทียบกับ
# Origin ปัจจุบันเองเสมอ ไม่ต้องพึ่ง Header ใดๆ) — ไม่ใส่ -H จึง Bind ทุก Interface
# (0.0.0.0) แต่ยังปลอดภัยเท่าเดิมเพราะ ufw ปิดพอร์ต 3000 จากภายนอกอยู่แล้ว (ยืนยันแล้ว
# ด้วย nc -z จากเครื่องนอก) — ufw คือ Security Boundary จริง ไม่ใช่ Bind Address —
# ทางเข้าเดียวจากสาธารณะยังเป็น Caddy (443) ผ่าน 127.0.0.1:3000 ภายในเครื่องเท่านั้น
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

# Hardening พื้นฐานของ systemd — จำกัดสิ่งที่ Process ทำได้แม้ถูกยึด
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# แอปต้องเขียนได้แค่ logs/ กับ backups/ ใต้ WorkingDirectory เท่านั้น
ReadWritePaths=/opt/bill-system/logs /opt/bill-system/backups

[Install]
WantedBy=multi-user.target
